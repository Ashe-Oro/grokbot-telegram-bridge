# Copy to .env and fill in. Keep .env private: chmod 600 .env
# Real environment variables override anything in this file.
# Never commit .env. It is listed in .gitignore.

# --- required ---
# Token from @BotFather (looks like 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# Webhook routine on the receiving Grok Bot. Copy both from the Grok Bot desktop app:
# open the bot -> Details -> Routines -> your routine -> Webhook section ("POST to" and "key").
# Without both, the bridge only runs in pairing mode (start.sh --pairing-only).
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=

# --- optional ---
# Admins: Telegram user ids whose messages go to the Grok Bot webhook (the full agent).
# The host puts their own id here to become the first admin. Everyone else defaults to member.
# Comma or space separated. Use /whoami or a pairing code to learn an id.
GROKBOT_ADMINS=

# Members from the start: chat-only, answered by a no-tools chat model, never the webhook.
# Ids are added to state.json at startup; removing an id here does not remove it from
# state.json (use: python3 approve.py --remove <id>). Nobody listed here is ever demoted.
GROKBOT_ALLOWLIST=

# --- member chat (optional; without a key, members are told the bot only chats with admins) ---
# Any OpenAI-compatible chat-completions API. The relay sends no tools, ever.
# Member messages (and their photos) are sent to this provider.
GROKBOT_MEMBER_LLM_API_KEY=
# Default: https://api.x.ai/v1
GROKBOT_MEMBER_LLM_BASE_URL=
# Default: grok-4.3 (text and image input)
GROKBOT_MEMBER_LLM_MODEL=
# Seconds per member reply. Default: 60.
GROKBOT_MEMBER_LLM_TIMEOUT=
# 1 (default) sends member photos (JPEG/PNG) to the model; 0 sends only the caption.
GROKBOT_MEMBER_LLM_VISION=

# Name used in the "isn't connected yet" reply and as the members' chat persona.
GROKBOT_BOT_NAME=

# Where state.json, outbox/, media/, relay.log and relay.pid live. Default: this folder.
# The Grok Bot must read media/ and write outbox/ at these exact absolute paths.
GROKBOT_DATA_DIR=

# Voice notes: python inside the faster-whisper venv. Default: ./.venv-asr/bin/python
GROKBOT_ASR_PYTHON=
# faster-whisper model. Default: base.en (English). "small" is multilingual but slower.
GROKBOT_ASR_MODEL=
# Seconds to wait for one transcription. Default: 180.
GROKBOT_ASR_TIMEOUT=
# Maximum accepted voice duration and ffmpeg output duration in seconds. Default: 600.
GROKBOT_ASR_MAX_SECONDS=
# Maximum decoded float32 PCM bytes buffered by ffmpeg decoding. Default: 67108864 (64 MiB).
GROKBOT_ASR_MAX_PCM_BYTES=

# Seconds to keep refreshing Telegram's "typing..." while a reply is pending. Default: 180.
GROKBOT_TYPING_MAX=
